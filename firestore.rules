rules_version = '2';

// Sicherheitsregeln für Paddy's Mealplan.
//
// WICHTIG: Diese Datei ist die Vorlage. Wirksam wird sie erst, wenn der Inhalt in der
// Firebase-Konsole unter Firestore Database -> Regeln eingefügt und VERÖFFENTLICHT wird.
// Sie liegt hier im Repo, damit nachvollziehbar ist, was gelten soll.
//
// Stand: 2026-08-15 — DIESE FASSUNG IST SEIT DEM 15.08.2026 VEROEFFENTLICHT UND WIRKSAM.
// (Im Regel-Editor gegengeprueft. Repo-Stand und Konsole sind damit identisch.)
//
// Bewusst in Kauf genommen: Zum Zeitpunkt der Veroeffentlichung gab es acht Gruppen, aber
// nur EIN entitlements-Dokument. Die uebrigen sieben Gruppen koennen seitdem nicht mehr
// gemeinsam planen (lesen ja, schreiben nein). Das ist kein Fehler, sondern die Pro-Grenze -
// Entscheidung des Inhabers in Kenntnis der Folge.
//
// ACHTUNG, VOR DEM VEROEFFENTLICHEN LESEN (D2b):
// Diese Fassung macht das GRUENDEN einer Gruppe und das Einladen zu Pro-Funktionen.
// Cloud-Sync ist ausdruecklich NICHT betroffen und bleibt fuer jedes Konto offen; ebenso
// das BEITRETEN zu einer Gruppe, weil dort der Inhaber zahlt (docs/PRODUCT.md, "Premium").
//
// Vorher zwingend:
//   1. Den entitlements-Block (D1) muss es in der Konsole bereits geben - sonst liest
//      die App dauerhaft "kein Pro" und niemand kann mehr eine Gruppe gruenden.
//   2. Wer heute schon eine Gruppe hat, braucht ein entitlements/{uid}-Dokument, sonst
//      kann er ihr keine weitere Person mehr hinzufuegen (Anleitung: FIREBASE-SETUP.md).
//      Bestehende Gruppen laufen unabhaengig davon weiter - Lesen und Schreiben im
//      gemeinsamen Plan pruefen die Berechtigung des Inhabers, nicht die der Mitglieder.
// Lesen und Loeschen bleiben in JEDEM Fall offen - Art. 15, 17 und 20 DSGVO.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helfer für "Gemeinsam planen" (Gruppen) ----
    // Die Mitgliedschaft steht in einem eigenen Dokument je Person, nicht als Feld im
    // Gruppendokument: nur so lässt sich sauber trennen, wer seinen eigenen Eintrag
    // ändern darf (Name, Bild) und wer Rollen vergeben darf (nur der Inhaber).
    function memberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }
    function isMember(gid) {
      return request.auth != null && exists(memberPath(gid));
    }
    function myRole(gid) {
      return get(memberPath(gid)).data.role;
    }
    // "edit" = mitplanen (Meals anlegen und einplanen), "view" = nur mitlesen.
    function canWrite(gid) {
      return isMember(gid) && (myRole(gid) == "owner" || myRole(gid) == "edit");
    }
    function isOwner(gid) {
      return isMember(gid) && myRole(gid) == "owner";
    }
    function inviteData(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }

    // ---- Mitgliederlimit (16.08.2026) ----
    //
    // Eine Gruppe traegt hoechstens vier Personen: Paar, WG oder Familie. Ohne Limit war
    // "Gemeinsam planen" ein Familien-Abo, das nie verkauft wurde - Pro traegt das GRUENDEN
    // einer Gruppe, und ein einmal weitergereichter Einladungslink liess beliebig viele herein.
    //
    // Rules koennen nicht zaehlen: Es gibt kein count() auf eine Unterkollektion. Deshalb
    // fuehrt das Gruppendokument ein Feld memberCount, das ueber getAfter() hart an die
    // Mitgliedschaft gekoppelt ist - wer beitritt, MUSS im selben Batch hochzaehlen, wer
    // austritt, MUSS herunterzaehlen. getAfter() liefert den Stand NACH dem Batch; get()
    // liefert den davor (dieselbe Semantik, die CloudGroup.dissolve() im Client ausnutzt).
    //
    // Die 4 steht auch im Client als MAX_GROUP_MEMBERS. Beide Stellen gehoeren zusammen -
    // verbindlich ist aber ausschliesslich diese hier (CLAUDE.md, Ziffer 18).
    function maxMitglieder() { return 4; }

    function grpPath(gid)  { return /databases/$(database)/documents/groups/$(gid); }
    function grpNow(gid)   { return get(grpPath(gid)).data; }
    function grpAfter(gid) { return getAfter(grpPath(gid)).data; }

    // Genau eine Aenderung am Zaehler und sonst NICHTS. Ohne hasOnly() liesse sich unter dem
    // Deckmantel eines Beitritts auch der Inhaber austauschen oder eine Einstellung kippen.
    function zaehlerNurUm(delta) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && request.resource.data.memberCount == resource.data.memberCount + delta;
    }

    // ---- Pro-Grenze (D2b) ----
    //
    // Pro-Funktion ist das GRUENDEN einer Gruppe samt Einladen. Cloud-Sync ausdruecklich
    // NICHT, und Beitreten ebenfalls nicht (docs/PRODUCT.md, "Premium").
    //
    // Die Berechtigung eines BELIEBIGEN Kontos, nicht nur des Anfragenden: beim
    // Gruppenzugriff zaehlt die des Inhabers (siehe unten). Ein abgelaufenes "until"
    // zaehlt als kein Pro - dieselbe Pruefung wie in isPro() im Client.
    // "until" wird als Firestore-Timestamp erwartet; fehlt es oder ist es null, gilt die
    // Berechtigung unbefristet (Testkonten, lebenslange Kaeufe).
    function entitlementOf(uid) {
      return get(/databases/$(database)/documents/entitlements/$(uid)).data;
    }
    function hasPro(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && entitlementOf(uid).pro == true
        && (!("until" in entitlementOf(uid))
            || entitlementOf(uid).until == null
            || entitlementOf(uid).until > request.time);
    }

    // ---- Konto-Daten: Plan, Meals, Profil ----
    // Jede Person liest und schreibt ausschließlich ihr eigenes Dokument.
    //
    // KEINE Pro-Pruefung hier, und das ist eine ausdrueckliche Entscheidung (15.08.2026):
    // Cloud-Sync ist die Grunderwartung an ein Konto, kein Zusatznutzen - wer sich anmeldet,
    // will seine Meals auf dem zweiten Geraet sehen. D2b hatte diese Regel kurzzeitig hinter
    // hasPro() gelegt; zurueckgenommen am selben Tag, ohne dass sie je veroeffentlicht war.
    // Pro traegt stattdessen die Gruppe (siehe groupOwnerHasPro weiter unten).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Pro-Berechtigung (D1) ----
    //
    // Der Pro-Status steht BEWUSST NICHT in users/{uid}. Dieses Dokument darf die Nutzerin
    // selbst schreiben — ein Feld "pro" darin wäre mit den Entwicklerwerkzeugen in zwei
    // Sekunden auf true gesetzt, und die Sperre wäre eine reine Anzeige (CLAUDE.md §18:
    // UI-Sperren sind keine Sicherheitsgrenze).
    //
    // Deshalb ein eigenes Dokument, das der Client nur LESEN darf. Geschrieben wird es
    // ausschließlich serverseitig — vom Admin SDK bzw. später vom Webhook der
    // Store-Abrechnung (App Store / Google Play). "allow write: if false" gilt nicht für
    // das Admin SDK: das umgeht die Regeln grundsätzlich.
    //
    // Felder: { pro: bool, source: "manual"|"apple"|"google", until: timestamp|null }
    //
    // "get" statt "read": Niemand soll die Sammlung auflisten können — sie ist eine Liste
    // aller zahlenden Konten (gleiche Falle wie bei shared/, siehe unten).
    // Löschen ist die eine Ausnahme: Art. 17 DSGVO verlangt, dass beim Löschen des Kontos
    // ALLE zuordenbaren Daten verschwinden, und dieses Dokument hängt nicht unter users/{uid}.
    // Ein Client, der nur löschen darf, kann sich damit ausschließlich selbst schaden — er
    // kann sich kein Pro geben. Anlegen und Ändern bleiben dem Server vorbehalten.
    match /entitlements/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list, create, update: if false;
    }

    // ---- Rezepte: eigenes Dokument je Meal, damit Fotos nicht mehr gegen die
    // 1-MiB-Grenze des Hauptdokuments laufen. Regeln vererben sich in Firestore
    // NICHT automatisch auf Subcollections - deshalb ein eigener Block, gleiche
    // Zugriffslogik wie beim Hauptdokument. ----
    match /users/{uid}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Geteilte Wochenplan-Snapshots ----
    //
    // ACHTUNG, hier steckte der Fehler: "allow read" umfasst in Firestore BEIDES,
    // "get" (ein Dokument per ID) UND "list" (die ganze Sammlung abfragen). Mit
    // "allow read" konnte jede angemeldete Person sämtliche geteilten Pläne samt
    // Namen auflisten - der Link war dann kein Schutz mehr, nur Bequemlichkeit.
    //
    // Deshalb ausdrücklich nur "get": Wer die ID nicht kennt, kommt nicht heran.
    // Die IDs sind kryptografisch zufällig (16 Zeichen, 80 Bit, siehe shareId()).
    match /shared/{id} {
      allow get: if request.auth != null;

      // Anlegen nur für angemeldete Personen und nur mit der eigenen uid im Dokument,
      // damit der Snapshot zuordenbar bleibt.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // Löschen darf nur, wer den Snapshot erstellt hat (Art. 17 DSGVO).
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;

      // Ändern ist niemandem erlaubt: ein geteilter Snapshot ist eine Momentaufnahme.
      allow update: if false;
    }

    // ================= Gemeinsam planen (Gruppen) =================
    //
    // WICHTIG: Diese Regeln sind die EINZIGE verbindliche Durchsetzung der Rollen.
    // Die Sperren in der Oberfläche ("Nur ansehen" blendet Knöpfe aus) sind reiner
    // Komfort und mit den Entwicklerwerkzeugen des Browsers umgehbar.

    // ---- Pro in der Gruppe: es zaehlt der INHABER, nicht das Mitglied ----
    //
    // Waere Cloud-Sync fuer jeden Beteiligten Pro-pflichtig, hiesse "gemeinsam planen",
    // dass BEIDE zahlen - jede Einladung waere eine Verkaufsaufforderung an den Partner.
    // Das passt nicht zu "Paar oder WG" (docs/PRODUCT.md). Entscheidung vom 13.08.2026:
    // Der Inhaber braucht Pro, die Mitglieder nicht.
    //
    // Kosten je Schreibvorgang: das Mitglieder-Dokument (canWrite), das Gruppendokument
    // (fuer den Inhaber) und das entitlements-Dokument, das hasPro() sowohl mit exists()
    // als auch mit get() anfasst - zusammen drei bis vier. Die Grenze liegt bei 10.
    //
    // LESEN bleibt in der ganzen Gruppe frei, auch wenn die Berechtigung des Inhabers
    // ablaeuft. Sonst verloeren Dritte den Zugriff auf ihre eigene Planung, weil jemand
    // anderes nicht verlaengert hat.
    function groupOwnerHasPro(gid) {
      return hasPro(get(/databases/$(database)/documents/groups/$(gid)).data.owner);
    }

    // ---- Die Gruppe selbst: Name und Einstellungen ----
    match /groups/{gid} {
      allow get: if isMember(gid);
      // Wie bei shared/: NIE auflistbar. Wäre "list" erlaubt, könnte jede angemeldete
      // Person sämtliche Gruppen samt Namen abfragen.
      allow list: if false;

      // Gruenden ist eine Pro-Funktion (D2b). Beitreten ausdruecklich nicht - siehe
      // groupOwnerHasPro() oben.
      // memberCount startet bei 1: Der Gruender ist das erste Mitglied.
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && hasPro(request.auth.uid)
                    && request.resource.data.memberCount == 1;

      // Vier Wege, das Gruppendokument zu ändern - mehr gibt es nicht.
      allow update: if
        // 1) Der Inhaber ändert Name, Einstellungen oder status. Den Zähler NIE: sonst wäre
        //    das Limit eine Bitte. Der Migrationszweig steht VOR dem Vergleich, weil bei
        //    einer Gruppe aus der Zeit ohne das Feld resource.data.memberCount ein Fehler
        //    wäre und nicht etwa false - er erlaubt dem Inhaber, es einmalig nachzutragen.
        ( isOwner(gid)
          && request.resource.data.owner == resource.data.owner
          && ( !("memberCount" in resource.data)
               || request.resource.data.memberCount == resource.data.memberCount ) )

        // 2) Beitritt: genau +1, und nur wenn ich vorher KEIN und nachher Mitglied bin.
        //    Beides zusammen macht den Zähler fälschungssicher - ein Hochzählen ohne
        //    tatsächlichen Beitritt scheitert an existsAfter().
        || ( request.auth != null
             && zaehlerNurUm(1)
             && resource.data.memberCount < maxMitglieder()
             && !exists(memberPath(gid))
             && existsAfter(memberPath(gid)) )

        // 3) Austritt: genau -1, und nur wenn ich danach wirklich draußen bin.
        || ( request.auth != null
             && zaehlerNurUm(-1)
             && exists(memberPath(gid))
             && !existsAfter(memberPath(gid)) )

        // 4) Der Inhaber entfernt jemanden. Ziffer 8a der Datenschutzerklärung sagt diese
        //    Funktion ausdrücklich zu, und diese Regel sieht nicht, WEN er im selben Batch
        //    löscht - deshalb ist der Zweig weiter als die übrigen. Bekannte Grenze: Ein
        //    Inhaber mit Entwicklerwerkzeugen kann den Zähler senken, ohne jemanden zu
        //    entfernen. Gegen Beitretende ist der Riegel dicht, gegen den Zahlenden am
        //    eigenen Abo ist er eine Bremse. Siehe docs/TROUBLESHOOTING.md.
        || ( isOwner(gid) && zaehlerNurUm(-1) );

      allow delete: if isOwner(gid);
    }

    // ---- Mitglieder: ein Dokument je Person ----
    match /groups/{gid}/members/{uid} {
      allow get, list: if isMember(gid);

      // Zwei Wege hinein:
      // 1) Der Gründer legt sich selbst als Inhaber an (die Gruppe gehört ihm bereits).
      // 2) Beitritt über einen Einladungscode. Der Code bestimmt Gruppe UND Rolle, und
      //    beides wird gegengeprüft - sonst könnte sich jeder mit einem Nur-Lesen-Code
      //    selbst zum Inhaber oder Mitplaner machen.
      // Der Gründer zählt NICHT hoch: memberCount steht beim Anlegen der Gruppe schon auf 1,
      // er ist darin bereits enthalten. Der Beitritt dagegen muss im selben Batch hochzählen -
      // ohne getAfter() liesse sich ein Mitglied anlegen und der Zähler einfach weglassen.
      allow create: if request.auth != null && request.auth.uid == uid
                    && (
                         (grpNow(gid).owner == request.auth.uid
                          && request.resource.data.role == "owner"
                          && grpNow(gid).memberCount == 1)
                      || (request.resource.data.via is string
                          && inviteData(request.resource.data.via).gid == gid
                          && inviteData(request.resource.data.via).role == request.resource.data.role
                          && request.resource.data.role in ["edit", "view"]
                          && grpNow(gid).memberCount < maxMitglieder()
                          && grpAfter(gid).memberCount == grpNow(gid).memberCount + 1)
                       );

      // ================== STUFE 2, NOCH NICHT VERÖFFENTLICHEN ==================
      //
      // Die beiden Zeilen unten machen den Code-Verbrauch zur harten Grenze. Sie gehören in
      // den obigen Zweig 2, direkt hinter die grpAfter-Zeile - aber ERST, wenn kein alter
      // Client mehr unterwegs ist:
      //
      //     && inviteData(request.resource.data.via).get("used", false) != true
      //     && inviteAfter(request.resource.data.via).get("used", false) == true
      //
      // dazu oben zu den Helfern:
      //
      //     function inviteAfter(code) {
      //       return getAfter(/databases/$(database)/documents/invites/$(code)).data;
      //     }
      //
      // WARUM GESTAFFELT, und das ist der ganze Punkt:
      //
      // Die update-Erlaubnis für invites (unten) ist eine reine ERWEITERUNG - sie bricht
      // keinen alten Client. Diese zwei Zeilen sind es NICHT: Sie VERLANGEN, dass der
      // Beitretende den Code im selben Batch als verbraucht markiert. Ein Client, der das
      // noch nicht tut, kann dann überhaupt nicht mehr beitreten.
      //
      // Zwischen einem Regel-Deploy und dem Ankommen des neuen Clients liegt bei GitHub Pages
      // der Service Worker und der Browser-Cache - alte Clients sind also garantiert eine
      // Weile unterwegs. Genau diese Fehlerklasse hat am 16.08.2026 den Beitritt für alle
      // außer dem Inhaber unmöglich gemacht (docs/TROUBLESHOOTING.md 101).
      //
      // Die Reihenfolge lautet deshalb:
      //   1. Regeln mit `allow update` veröffentlichen (dieser Stand hier) - bricht nichts.
      //   2. Client ausrollen, der `used: true` mitschreibt - funktioniert mit Stand 1.
      //   3. Erst danach diese zwei Zeilen einkommentieren und erneut veröffentlichen.
      //
      // Bis Schritt 3 prüft nur der Client auf `used`. Das ist eine Bequemlichkeit, keine
      // Grenze (CLAUDE.md, Ziffer 18) - Schritt 3 ist Pflicht, nicht Kür.
      // =========================================================================

      // Name und Bild ändert jeder nur an sich selbst - und die eigene Rolle dabei NICHT.
      // Rollen vergibt ausschließlich der Inhaber, und nicht an sich selbst (sonst könnte
      // er sich versehentlich degradieren und die Gruppe wäre führungslos). Der Wertebereich
      // "edit"/"view" gilt hier ausdrücklich auch für fremde Mitglieder (Zeile 127) - ohne das
      // könnte der Inhaber ein fremdes role-Feld technisch auf einen beliebigen Wert setzen,
      // z. B. "owner". Nur er selbst könnte das (kein Weg für Dritte), aber es war unsauber.
      allow update: if request.auth != null
                    && (
                         (request.auth.uid == uid && request.resource.data.role == resource.data.role)
                      || (isOwner(gid) && uid != request.auth.uid
                          && request.resource.data.role in ["edit", "view"])
                       );

      // Selbst verlassen, oder vom Inhaber entfernt werden - und dabei den Zähler mit senken,
      // sonst bliebe der Platz für immer belegt.
      //
      // Die Ausnahme !existsAfter(grpPath(gid)) ist NICHT optional: CloudGroup.dissolve()
      // löscht alle Mitglieder UND das Gruppendokument in einem Batch. Ohne sie liesse sich
      // eine Gruppe nie wieder auflösen, weil grpAfter() auf ein Dokument zugriffe, das es
      // nach dem Batch nicht mehr gibt.
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || isOwner(gid))
                    && ( !existsAfter(grpPath(gid))
                         || grpAfter(gid).memberCount == grpNow(gid).memberCount - 1 );
    }

    // ---- Gemeinsamer Wochenplan: ein Dokument je ISO-Woche ----
    // Felder sind einzelne Slots ("mon_fr", "sat_ab"), damit gleichzeitiges Planen sich
    // nicht gegenseitig überschreibt. Hier greift "Nur ansehen" wirklich.
    match /groups/{gid}/plans/{weekKey} {
      allow get, list: if isMember(gid);
      // delete bewusst OHNE Pro-Pruefung: pruneWeeks() raeumt vergangene Wochen weg, und
      // eine Gruppe, deren Inhaber nicht verlaengert, soll nicht dauerhaft Karteileichen
      // ansammeln. Aufraeumen darf immer, wer ohnehin Mitglied mit Schreibrecht ist.
      allow create, update: if canWrite(gid) && groupOwnerHasPro(gid);
      allow delete: if canWrite(gid);
    }

    // ---- Gemeinsame Meals: gleiche Struktur wie users/{uid}/recipes ----
    match /groups/{gid}/recipes/{recipeId} {
      allow get, list: if isMember(gid);
      allow create, update: if canWrite(gid) && groupOwnerHasPro(gid);
      allow delete: if canWrite(gid);
    }

    // ---- Einladungscodes ----
    // Gleiches Modell wie shared/: der Code IST der Zugang, 80 Bit Zufall (shareId()).
    // Ausdrücklich nur "get", nie "list" - sonst wären alle Gruppen auffindbar.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      // Einladen darf ausschließlich der Inhaber der Gruppe. Das spart gegenüber einer
      // Einstellung "Mitplaner dürfen auch" einen get() je Einladung - und zu zweit gäbe
      // es nach dem Beitritt ohnehin niemanden mehr einzuladen.
      // Einladen ist Inhaber-Sache, und Inhaber sein setzt Pro voraus (D2b).
      // Für eine volle Gruppe entstehen erst gar keine Links - der freundlichere Riegel als
      // ein Beitritt, der am Ende doch abgewiesen wird.
      allow create: if request.auth != null
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.role in ["edit", "view"]
                    && isOwner(request.resource.data.gid)
                    && hasPro(request.auth.uid)
                    && grpNow(request.resource.data.gid).memberCount < maxMitglieder();

      // Ein Code ist unveränderlich - wer andere Rechte vergeben will, erzeugt einen neuen.
      // Die EINE Ausnahme seit dem 17.08.2026: Er darf beim Beitritt als verbraucht markiert
      // werden. Ohne das bleibt ein weitergereichter Link dauerhaft eine offene Tür - wer ihn
      // je gesehen hat, kommt herein, sobald ein Platz frei wird.
      //
      // Gespeichert wird ausschließlich `used: true`, KEINE UID des Beitretenden. Wer in der
      // Gruppe ist, sagt die Mitgliederliste; ein zweites Mal brauchte es dafür einen
      // Personenbezug in einem Dokument, das jeder Angemeldete lesen darf (CLAUDE.md,
      // Ziffer 20).
      //
      // Die drei Bedingungen sind einzeln nötig:
      //   1. `used` ist eine Einbahnstraße - ein einmal verbrauchter Code wird nie wieder frei.
      //   2. hasOnly(["used"]) - sonst ließe sich über diesen Weg die Rolle hochschreiben.
      //   3. !exists() UND existsAfter() auf die eigene Mitgliedschaft - der Code darf nur von
      //      jemandem verbraucht werden, der in genau diesem Batch beitritt.
      //
      // Punkt 3 stand im ersten Entwurf nur als existsAfter() da, mit der Begründung, damit
      // könne "niemand einen Code verbrennen, ohne selbst beizutreten". Das war falsch:
      // existsAfter() beschreibt den Zustand NACH dem Batch, und für ein BEREITS bestehendes
      // Mitglied ist er ohne jede weitere Aktion erfüllt. Jedes Mitglied - auch eines mit
      // "Nur ansehen" - hätte damit jeden offenen Code der eigenen Gruppe per einzelnem
      // update() verbrennen können, ohne beizutreten. Mit Stufe 2 wäre daraus ein gezielter
      // Riegel gegen eine fremde, gerade weitergegebene Einladung geworden: Die eingeladene
      // Person käme nie mehr herein. Das unterläuft nebenbei die engere delete-Regel unten,
      // die das Zurückziehen bewusst auf Ersteller und Inhaber beschränkt.
      //
      // !exists() davor macht daraus den Zwei-Zustands-Riegel, den das Gruppendokument für
      // memberCount schon benutzt (Zweig 2 dort, gleiches Muster): vorher kein Mitglied,
      // nachher Mitglied - also ein echter, gerade stattfindender Beitritt.
      //
      // get("used", false) statt .used: Der Zugriff auf ein FEHLENDES Feld lässt die
      // Regelauswertung scheitern, und bei jedem heute bestehenden Code fehlt es.
      allow update: if request.auth != null
                    && resource.data.get("used", false) != true
                    && request.resource.data.used == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used"])
                    && !exists(memberPath(resource.data.gid))
                    && existsAfter(memberPath(resource.data.gid));

      // Zurückziehen darf, wer ihn erzeugt hat, sowie der Inhaber der Gruppe.
      allow delete: if request.auth != null
                    && (resource.data.by == request.auth.uid || isOwner(resource.data.gid));
    }
  }
}
