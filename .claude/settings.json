{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/commit-waechter.py",
            "timeout": 20,
            "statusMessage": "Commit-Waechter prueft den Index"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/secrets-filter.py",
            "timeout": 10,
            "statusMessage": "Secrets-Filter"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/push-waechter.py",
            "timeout": 20,
            "statusMessage": "Push-Waechter prueft den Pruefstand"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/syntax-nach-edit.py",
            "timeout": 120,
            "statusMessage": "Syntax-Check laeuft"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/wartung-erinnerung.py",
            "timeout": 15,
            "statusMessage": "Wartungsstand pruefen"
          }
        ]
      }
    ]
  }
}
